# Chhota Genius Environment Configuration Example
# Never place real secrets in source control or this example file.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# PostgreSQL Database Connection URL
# For local PostgreSQL: postgresql://<user>:<password>@localhost:5432/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chhota_genius?schema=public"

# Auth Session Secret (Must be a 32+ byte string in production)
# Generate with: openssl rand -base64 32
AUTH_SECRET="development-secret-must-be-changed-in-production-min-32-chars-long"

# Object Storage Configuration
# Options: 'local' (development), 's3' (production)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./public/uploads"

# Optional Cloud Storage (e.g. AWS S3, Cloudflare R2, MinIO)
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET_NAME=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
