datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum AgeBand {
  BAND_3_5
  BAND_6_8
}

enum ContentCategory {
  ALPHABETS
  NUMBERS
  ANIMALS
  LANGUAGES
  SCIENCE
  ART
  GOOD_HABITS
}

enum Language {
  ENGLISH
  HINDI
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ActivityType {
  QUIZ
  MATCHING
  SORTING
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum TransactionType {
  EARNED_ACTIVITY
  REWARD_REDEMPTION
  PARENT_ADJUSTMENT
  REFUND_REDEMPTION
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  REJECTED
  FULFILLED
}

// -------------------------------------------------------------
// Models
// -------------------------------------------------------------

model Parent {
  id                            String   @id @default(cuid())
  email                         String   @unique
  passwordHash                  String
  name                          String
  role                          String   @default("PARENT") // PARENT | ADMIN
  dailyScreenTimeMinutesDefault Int      @default(30)
  sessionBreakReminderMinutes   Int      @default(15)
  monthlyRewardCoinBudget       Int      @default(200)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  children         Child[]
  rewards          Reward[]
  contentApprovals ParentContentApproval[]

  @@map("parents")
}

model Child {
  id                     String   @id @default(cuid())
  parentId               String
  name                   String   // Nickname or friendly display name only
  avatar                 String   @default("lion")
  ageBand                AgeBand  @default(BAND_3_5)
  preferredLanguage      Language @default(ENGLISH)
  dailyScreenTimeMinutes Int      @default(30)
  breakReminderMinutes   Int      @default(15)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  parent            Parent                  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  contentApprovals  ParentContentApproval[]
  learningAttempts  LearningAttempt[]
  coinTransactions  CoinTransaction[]
  rewardRedemptions RewardRedemption[]
  screenSessions    ScreenSession[]

  @@index([parentId])
  @@map("children")
}

model ContentItem {
  id                String            @id @default(cuid())
  title             String
  description       String
  category          ContentCategory
  language          Language          @default(ENGLISH)
  ageBand           AgeBand           @default(BAND_3_5)
  durationSeconds   Int               @default(120)
  publicationStatus PublicationStatus @default(PUBLISHED)
  storageKey        String
  thumbnailKey      String
  uploader          String?
  isSampleContent   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  approvals  ParentContentApproval[]
  activities LearningActivity[]

  @@index([category, ageBand, publicationStatus])
  @@map("content_items")
}

model ParentContentApproval {
  id            String         @id @default(cuid())
  parentId      String
  childId       String
  contentItemId String
  status        ApprovalStatus @default(APPROVED)
  decidedAt     DateTime       @default(now())

  parent      Parent      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child       Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([childId, contentItemId])
  @@index([parentId, childId])
  @@map("parent_content_approvals")
}

model LearningActivity {
  id             String          @id @default(cuid())
  contentItemId  String?
  title          String
  description    String
  activityType   ActivityType    @default(QUIZ)
  ageBand        AgeBand         @default(BAND_3_5)
  language       Language        @default(ENGLISH)
  category       ContentCategory
  instructions   String
  coinReward     Int             @default(5) // Configurable bounded reward (e.g. 5 coins)
  questionsData  String          // Stored JSON payload: questions, options, server-verified keys
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  contentItem ContentItem?      @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  attempts    LearningAttempt[]

  @@index([category, ageBand])
  @@map("learning_activities")
}

model LearningAttempt {
  id             String        @id @default(cuid())
  childId        String
  activityId     String
  status         AttemptStatus @default(IN_PROGRESS)
  score          Int           @default(0)
  maxScore       Int           @default(0)
  passed         Boolean       @default(false)
  rewardAwarded  Boolean       @default(false)
  answersData    String?       // JSON of child submission
  startedAt      DateTime      @default(now())
  completedAt    DateTime?

  child            Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  activity         LearningActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  coinTransactions CoinTransaction[]

  @@index([childId, activityId])
  @@map("learning_attempts")
}

model CoinTransaction {
  id                String          @id @default(cuid())
  childId           String
  amount            Int             // Positive for credits, negative for debits
  type              TransactionType
  reason            String
  idempotencyKey    String?         @unique // Critical: guarantees idempotent ledger entries
  learningAttemptId String?
  redemptionId      String?
  createdAt         DateTime        @default(now())

  child           Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  learningAttempt LearningAttempt?  @relation(fields: [learningAttemptId], references: [id], onDelete: SetNull)
  redemption      RewardRedemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)

  @@index([childId, createdAt])
  @@map("coin_transactions")
}

model Reward {
  id          String   @id @default(cuid())
  parentId    String
  title       String   // e.g. "Family Park Visit", "Sticker Pack", "Bedtime Story Pick"
  description String
  category    String   @default("OFFLINE_TREAT")
  coinCost    Int      @default(20)
  icon        String   @default("gift")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Parent             @relation(fields: [parentId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]

  @@index([parentId])
  @@map("rewards")
}

model RewardRedemption {
  id          String           @id @default(cuid())
  childId     String
  rewardId    String
  coinCost    Int
  status      RedemptionStatus @default(REQUESTED)
  parentNote  String?
  requestedAt DateTime         @default(now())
  decidedAt   DateTime?

  child            Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  reward           Reward            @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  coinTransactions CoinTransaction[]

  @@index([childId, status])
  @@map("reward_redemptions")
}

model ScreenSession {
  id              String    @id @default(cuid())
  childId         String
  sessionToken    String    @unique
  startedAt       DateTime  @default(now())
  lastHeartbeatAt DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  isActive        Boolean   @default(true)

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, isActive])
  @@map("screen_sessions")
}
